#!/bin/bash
# credential_process for the deploy-ipa aws profile: reads the keys from the login Keychain
set -euo pipefail

id=$(security find-generic-password -s deploy-ipa -a access-key-id -w)
secret=$(security find-generic-password -s deploy-ipa -a secret-access-key -w)
printf '{"Version":1,"AccessKeyId":"%s","SecretAccessKey":"%s"}\n' "$id" "$secret"
