#!/bin/bash
set -euo pipefail
#
# Set up deploy-ipa on this Mac, or check an existing setup.
#
# Usage: setup           asks for the AWS keys and bucket, then checks them
#        setup --check   only runs the checks, asking nothing
#
# Run it in your own Terminal: the keys are typed there, straight into the login Keychain
# (service deploy-ipa), and never pass through Claude. It writes the settings to
# ~/.config/deploy-ipa.env (or DEPLOY_IPA_ENV), copies the Keychain helper to
# ~/.config/deploy-ipa/aws-credentials and adds a profile to ~/.aws/config (or AWS_CONFIG_FILE).
#

HERE="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="${DEPLOY_IPA_ENV:-$HOME/.config/deploy-ipa.env}"
AWS_CONFIG="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
HELPER="$HOME/.config/deploy-ipa/aws-credentials"
SERVICE=deploy-ipa
FAILURES=0

ok() { echo "  ok    $*"; }
note() { echo "  note  $*"; }
bad() { echo "  FAIL  $*"; FAILURES=$((FAILURES + 1)); }

# ask <variable> <question> [default]
ask() {
    local answer=""
    if [ -n "${3:-}" ]; then
        read -r -p "$2 [$3]: " answer || true
    else
        read -r -p "$2: " answer || true
    fi
    printf -v "$1" '%s' "${answer:-${3:-}}"
}

keychain_has() { security find-generic-password -s "$SERVICE" -a "$1" >/dev/null 2>&1; }

# offer to store or replace a Keychain item, typed into security's own prompt
keychain_store() {
    local replace=y
    if keychain_has "$1"; then
        ask replace "  $2 is already in the Keychain; replace it? (y/n)" n
    fi
    if [ "$replace" = y ]; then
        echo "  Type the $2 at the prompt; it goes in the Keychain as $SERVICE / $1."
        security add-generic-password -U -s "$SERVICE" -a "$1" -w
    fi
}

# single quoted for the env file, which bash sources
quoted() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

check_tools() {
    echo "Tools:"
    local tool
    for tool in aws jq python3 curl xcodebuild plutil security zip ditto; do
        if command -v "$tool" >/dev/null; then ok "$tool"; else bad "$tool is missing"; fi
    done
    # console builds use export-credentials, which arrived in aws CLI 2.9
    if command -v aws >/dev/null; then
        local major="" minor=""
        read -r major minor < <(aws --version 2>&1 | sed -nE 's|^aws-cli/([0-9]+)\.([0-9]+).*|\1 \2|p') || true
        if [ "${major:-0}" -gt 2 ] || { [ "${major:-0}" -eq 2 ] && [ "${minor:-0}" -ge 9 ]; }; then
            ok "aws CLI $major.$minor"
        else
            bad "aws CLI 2.9 or later is needed, found ${major:-?}.${minor:-?} (brew install awscli)"
        fi
    fi
}

check() {
    check_tools

    echo "Settings in $ENV_FILE:"
    if [ ! -f "$ENV_FILE" ]; then
        bad "missing; run $HERE/setup"
        return
    fi
    source "$ENV_FILE"
    local name
    for name in DEPLOY_IPA_PROFILE DEPLOY_IPA_BUCKET DEPLOY_IPA_PREFIX; do
        if [ -n "${!name:-}" ]; then ok "$name=${!name}"; else bad "$name is not set"; fi
    done
    if [ -z "${DEPLOY_IPA_PROFILE:-}" ] || [ -z "${DEPLOY_IPA_BUCKET:-}" ] || [ -z "${DEPLOY_IPA_PREFIX:-}" ]; then
        return
    fi
    local profile="$DEPLOY_IPA_PROFILE" bucket="$DEPLOY_IPA_BUCKET" prefix="$DEPLOY_IPA_PREFIX"

    echo "AWS:"
    local account
    for account in access-key-id secret-access-key; do
        if keychain_has "$account"; then ok "$account in the Keychain"; else bad "$account is not in the Keychain"; fi
    done
    local identity region location
    if identity=$(aws --profile "$profile" sts get-caller-identity --query Arn --output text 2>&1); then
        ok "profile $profile signs in as $identity"
    else
        bad "profile $profile cannot sign in: $identity"
        return
    fi
    region=$(aws --profile "$profile" configure get region 2>/dev/null || true)
    if location=$(aws --profile "$profile" s3api get-bucket-location --bucket "$bucket" --query LocationConstraint --output text 2>&1); then
        if [ "$location" = None ]; then location=us-east-1; fi
        if [ "$location" = "$region" ]; then
            ok "bucket $bucket is in $region, as the profile says"
        else
            bad "bucket $bucket is in $location but profile $profile says ${region:-no region}"
        fi
    else
        note "could not read the region of $bucket ($location); signed links fail if it is not ${region:-set}"
    fi

    # a download link, the same link without its signature, and a console style upload
    local key="$prefix/setup-check-$(date +%s).txt" url status
    if printf 'deploy-ipa setup check\n' | aws --profile "$profile" s3 cp - "s3://$bucket/$key" --only-show-errors 2>/dev/null; then
        ok "upload to s3://$bucket/$prefix/"
        url=$(aws --profile "$profile" s3 presign "s3://$bucket/$key" --expires-in 300)
        status=$(curl -s -o /dev/null -w '%{http_code}' "$url")
        if [ "$status" = 200 ]; then ok "signed link downloads"; else bad "signed link gave HTTP $status"; fi
        status=$(curl -s -o /dev/null -w '%{http_code}' "${url%%\?*}")
        if [ "$status" = 403 ]; then ok "the link without its signature is refused"; else bad "the bucket served an unsigned link (HTTP $status); block public access"; fi
        aws --profile "$profile" s3 rm "s3://$bucket/$key" --only-show-errors || bad "could not delete the test object $key"
    else
        bad "could not upload to s3://$bucket/$prefix/; see iam-policy.json"
    fi

    local encoded config form=() field target
    if encoded=$("$HERE/upload-policy" "$prefix/setup-check/" 2>&1); then
        config=$(base64 -D <<<"$encoded")
        while IFS= read -r field; do form+=(--form-string "$field"); done < <(jq -r '.fields | to_entries[] | "\(.key)=\(.value)"' <<<"$config")
        target="$prefix/setup-check/console-$(date +%s).log"
        status=$(printf 'deploy-ipa setup check\n' | curl -s -o /dev/null -w '%{http_code}' "${form[@]}" \
            --form-string "key=$target" -F "file=@-;filename=console.log" "$(jq -r .url <<<"$config")")
        if [ "$status" = 204 ]; then ok "console builds can upload"; else bad "console upload gave HTTP $status"; fi
        aws --profile "$profile" s3 rm "s3://$bucket/$target" --only-show-errors 2>/dev/null || true
    else
        bad "upload-policy failed: $encoded"
    fi
}

interactive() {
    if [ -f "$ENV_FILE" ]; then
        source "$ENV_FILE"
    fi
    echo "deploy-ipa setup. Press return to keep the value in brackets."
    echo
    echo "AWS keys of an IAM user that may only use your bucket (see iam-policy.json):"
    keychain_store access-key-id "access key id"
    keychain_store secret-access-key "secret access key"
    echo

    ask DEPLOY_IPA_BUCKET "S3 bucket, with public access blocked" "${DEPLOY_IPA_BUCKET:-}"
    echo "Everything under the prefix that is older than the link lifetime gets deleted, so use it for nothing else."
    ask DEPLOY_IPA_PREFIX "Key prefix" "${DEPLOY_IPA_PREFIX:-deploy-ipa}"
    ask DEPLOY_IPA_PROFILE "Name of the aws profile" "${DEPLOY_IPA_PROFILE:-deploy-ipa}"

    # signed links only work against the bucket's own region
    local region=""
    region=$(AWS_ACCESS_KEY_ID=$(security find-generic-password -s "$SERVICE" -a access-key-id -w) \
             AWS_SECRET_ACCESS_KEY=$(security find-generic-password -s "$SERVICE" -a secret-access-key -w) \
             aws s3api get-bucket-location --bucket "$DEPLOY_IPA_BUCKET" --region us-east-1 \
                 --query LocationConstraint --output text 2>/dev/null || true)
    if [ "$region" = None ]; then region=us-east-1; fi
    if [ -n "$region" ]; then
        echo "The bucket is in $region."
    else
        ask region "Region of the bucket, such as eu-north-1"
    fi

    # outside the skill folder, which plugin updates replace
    mkdir -p "$(dirname "$HELPER")"
    cp "$HERE/aws-credentials" "$HELPER"
    chmod 755 "$HELPER"
    if grep -q "^\[profile $DEPLOY_IPA_PROFILE\]" "$AWS_CONFIG" 2>/dev/null; then
        echo "Profile $DEPLOY_IPA_PROFILE is already in $AWS_CONFIG and stays as it is."
    else
        mkdir -p "$(dirname "$AWS_CONFIG")"
        printf '\n[profile %s]\nregion = %s\ncredential_process = "%s"\n' "$DEPLOY_IPA_PROFILE" "$region" "$HELPER" >> "$AWS_CONFIG"
        echo "Added profile $DEPLOY_IPA_PROFILE to $AWS_CONFIG."
    fi

    mkdir -p "$(dirname "$ENV_FILE")"
    if [ -f "$ENV_FILE" ]; then
        cp "$ENV_FILE" "$ENV_FILE.bak"
    fi
    {
        echo "# deploy-ipa settings, written by setup; the keys are in the Keychain"
        echo "DEPLOY_IPA_PROFILE=$(quoted "$DEPLOY_IPA_PROFILE")"
        echo "DEPLOY_IPA_BUCKET=$(quoted "$DEPLOY_IPA_BUCKET")"
        echo "DEPLOY_IPA_PREFIX=$(quoted "$DEPLOY_IPA_PREFIX")"
        echo "# signed links last this many seconds (7 days is the SigV4 maximum)"
        echo "DEPLOY_IPA_EXPIRES=${DEPLOY_IPA_EXPIRES:-604800}"
    } > "$ENV_FILE"
    echo "Wrote $ENV_FILE."
    echo
}

case "${1:-}" in
    --check) ;;
    "") interactive ;;
    *) echo "Usage: $0 [--check]" >&2; exit 1 ;;
esac

check
echo
if [ "$FAILURES" -eq 0 ]; then
    echo "All checks passed."
else
    echo "$FAILURES check(s) failed."
    exit 1
fi
